# ─── AI keys (Smart Fill) ───────────────────────────────────────
OPENAI_API_KEY=
TAVILY_API_KEY=
UNSPLASH_ACCESS_KEY=

# ─── Company email login ──────────────────────────────────────────
# Option A: allow whole company domain (recommended)
ALLOWED_DOMAIN=yourcompany.com

# Option B: allow specific emails (comma separated)
# ALLOWED_EMAILS=you@yourcompany.com,team@yourcompany.com

# Session signing — change to a long random string
SESSION_SECRET=change-this-to-a-long-random-string

# OTP settings
OTP_TTL_MINUTES=10
OTP_RESEND_COOLDOWN=60

# ─── Email OTP delivery ───────────────────────────────────────────
# Gmail example: smtp.gmail.com, port 587, use App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Creative Studio <noreply@yourcompany.com>

# Testing without SMTP — OTP prints in server terminal
# MOCK_OTP=true

# ─── Server ───────────────────────────────────────────────────────
PORT=3001
ALLOWED_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
